# Development: Vite proxies /api to FastAPI on port 8000.
AREA_LAB_DATA_DIR=./data
# Larger original DPU netlists can exceed the initial INT8 pilot's 180 seconds.
# Positive seconds per command. Compose reads .env or the shell environment.
# For longer LNS runs, try 3600; the default remains 900 (15 minutes).
AREA_LAB_COMMAND_TIMEOUT_SECONDS=900
